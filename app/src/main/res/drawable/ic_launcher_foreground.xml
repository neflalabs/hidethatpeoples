<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Circular Privacy Halo / Background Disc -->
    <path
        android:pathData="M54,18 A36,36 0 1,1 53.9,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A38B6FF" />
                <item android:offset="1.0" android:color="#050077B6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Avatar: Head (Crisp Geometry with Modern Indigo/Cyan Gradient) -->
    <path
        android:pathData="M54,27 A12,12 0 1,1 53.9,27 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="27"
                android:endX="66"
                android:endY="51"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F0FF" />
                <item android:offset="1.0" android:color="#0077B6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Avatar: Torso / Body (Smooth Minimalist Dome) -->
    <path
        android:pathData="M31,77 C31,61 40,55 54,55 C68,55 77,61 77,77 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31"
                android:startY="55"
                android:endX="77"
                android:endY="77"
                android:type="linear">
                <item android:offset="0.0" android:color="#00B4D8" />
                <item android:offset="1.0" android:color="#023E8A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dynamic Diagonal Privacy Cut / Stealth Slash -->
    <!-- Sharp, high-contrast, clean 45-degree slash cutting right through the avatar -->
    <path
        android:strokeWidth="5"
        android:strokeColor="#10141C"
        android:strokeLineCap="round"
        android:pathData="M24,84 L84,24" />

    <path
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M26,82 L82,26">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="82"
                android:endX="82"
                android:endY="26"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF5252" />
                <item android:offset="0.4" android:color="#FF7597" />
                <item android:offset="1.0" android:color="#00E5FF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
